# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채우세요:  cp .env.example .env
# .env 는 GitHub에 올라가지 않아요 (.gitignore). 바꾼 뒤에는  sudo docker compose up -d  로 다시 띄우면 적용돼요.

# 스크린샷 닉네임 읽기용 Claude API 키 (https://console.anthropic.com 에서 발급)
# 비워 두면 '가입 확인' 화면에 키 입력칸이 나와서 매번 넣으면 돼요.
ANTHROPIC_API_KEY=

# 이미지 읽기 모델. 비워 두면 claude-opus-5-5 (정확, 4장에 약 100~170원)
# 더 싸게: claude-haiku-5-5 (4장에 약 5~10원)
CLAUDE_MODEL=
